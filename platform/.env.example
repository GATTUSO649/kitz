NODE_ENV=development
PORT=4001
PLATFORM_ORIGIN=http://127.0.0.1:5173
VITE_KITZ_ORIGIN=https://kitz.onrender.com
MARKETPLACE_DATABASE_URL=
MARKETPLACE_DATABASE_NAME=postgres
MARKETPLACE_DATABASE_HOST=
MARKETPLACE_DATABASE_USER=
MARKETPLACE_DATABASE_SCHEMA=marketplace
# Production only: verified CA certificate for the Supabase PostgreSQL server.
MARKETPLACE_DATABASE_CA=
# One-off migration commands only; use a schema-owner credential and never expose it to Vite.
MARKETPLACE_MIGRATION_DATABASE_URL=
# Daraja remains disabled until provider approval, credentials and callback verification.
MPESA_ENV=disabled
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_TRANSACTION_TYPE=
MPESA_CALLBACK_URL=
MPESA_CALLBACK_TOKEN=
# Persistent marketplace image storage is a separate Cloudinary account or namespace.
MARKETPLACE_CLOUDINARY_CLOUD_NAME=
MARKETPLACE_CLOUDINARY_API_KEY=
MARKETPLACE_CLOUDINARY_API_SECRET=
MARKETPLACE_ADMIN_EMAIL=
MARKETPLACE_ADMIN_PASSWORD=
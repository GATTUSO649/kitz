NODE_ENV=development
PORT=4001
PLATFORM_ORIGIN=http://127.0.0.1:5173
VITE_KITZ_ORIGIN=https://kitz.onrender.com
MARKETPLACE_DATABASE_URL=
MARKETPLACE_DATABASE_NAME=postgres
MARKETPLACE_DATABASE_HOST=
MARKETPLACE_DATABASE_USER=
MARKETPLACE_DATABASE_SCHEMA=marketplace
# Production only: verified CA certificate for the Supabase PostgreSQL server.
MARKETPLACE_DATABASE_CA=
# One-off migration commands only; use a schema-owner credential and never expose it to Vite.
MARKETPLACE_MIGRATION_DATABASE_URL=
# Daraja remains disabled until provider approval, credentials and callback verification.
MARKETPLACE_DARAJA_ENVIRONMENT=disabled
MARKETPLACE_DARAJA_CONSUMER_KEY=
MARKETPLACE_DARAJA_CONSUMER_SECRET=
MARKETPLACE_DARAJA_PASSKEY=
MARKETPLACE_DARAJA_SHORTCODE=
MARKETPLACE_DARAJA_TRANSACTION_TYPE=
# Exact HTTPS path: https://<markethub-host>/api/v1/marketplace/payments/callback/<MARKETPLACE_DARAJA_CALLBACK_TOKEN>
MARKETPLACE_DARAJA_CALLBACK_URL=
MARKETPLACE_DARAJA_CALLBACK_TOKEN=
# Persistent marketplace image storage is a separate Cloudinary account or namespace.
MARKETPLACE_CLOUDINARY_CLOUD_NAME=
MARKETPLACE_CLOUDINARY_API_KEY=
MARKETPLACE_CLOUDINARY_API_SECRET=
MARKETPLACE_ADMIN_EMAIL=
MARKETPLACE_ADMIN_PASSWORD=
# Transactional email uses Kitz's existing Brevo account with independent MarketHub settings.
MARKETPLACE_EMAIL_PROVIDER=disabled
MARKETPLACE_EMAIL_REPLY_TO=
# Brevo SMTP (copy Kitz's existing SMTP login/password into MarketHub's Render secrets).
MARKETPLACE_BREVO_SMTP_HOST=smtp-relay.brevo.com
MARKETPLACE_BREVO_SMTP_PORT=2525
MARKETPLACE_BREVO_SMTP_USER=
MARKETPLACE_BREVO_SMTP_PASSWORD=
MARKETPLACE_BREVO_SMTP_SECURE=false
MARKETPLACE_BREVO_SMTP_REQUIRE_TLS=true
# Use a sender address verified in the existing Brevo account.
MARKETPLACE_BREVO_FROM_EMAIL=
MARKETPLACE_BREVO_FROM_NAME=MarketHub
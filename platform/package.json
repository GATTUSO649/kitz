{
  "name": "kitculture-platform",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch server/src/server.ts",
    "dev:all": "concurrently -k \"npm:dev\" \"npm:dev:server\"",
    "typecheck": "tsc -b --pretty false && tsc -p server/tsconfig.json --noEmit",
    "build": "npm run typecheck && vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "build:deploy": "npm run build && npm run build:server",
    "start": "node server/dist/server.js",
    "db:generate": "drizzle-kit generate --config=server/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=server/drizzle.config.ts",
    "admin:provision": "tsx server/src/scripts/provision-marketplace-admin.ts",
    "lint": "oxlint src server/src",
    "test": "tsx --test server/src/app.test.ts server/src/modules/marketplace/security.test.ts server/src/modules/marketplace/images.test.ts server/src/modules/marketplace/expiry.test.ts server/src/modules/email/service.test.ts server/src/modules/email/outbox.test.ts server/src/workers/health.test.ts server/src/workers/scheduler.test.ts server/src/modules/payments/daraja.test.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.21",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "lucide-react": "^0.562.0",
    "nodemailer": "^10.3.1",
    "pg": "^8.23.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-icons": "^5.7.0",
    "react-router-dom": "^7.12.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.81.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}

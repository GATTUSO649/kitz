NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
LOG_LEVEL=info
DATABASE_URL=postgresql://postgres:replace-this-password@db.your-project-ref.supabase.co:5432/postgres
# Download the CA certificate from Supabase and keep it outside source control.
SUPABASE_CA_CERT_FILE=./certs/supabase-ca.pem
# For managed hosts such as Render, store the official PEM as a server-only secret instead of relying on a local file path.
# SUPABASE_CA_CERT=<official Supabase CA PEM>
# The legacy MySQL source remains available for rollback/data export only.
# MYSQL_URL=mysql://user:replace-this-password@host:3306/database

# Local Docker MySQL only. Use a dedicated, least-privilege database user in production.
MYSQL_DATABASE=kitculture
MYSQL_USER=kitculture_app
MYSQL_PASSWORD=replace-this-local-password
MYSQL_ROOT_PASSWORD=replace-this-local-root-password
# MYSQL SSL settings are only for connecting to the legacy source database.
# MYSQL_SSL_CA=
# MYSQL_SSL_VERIFY=true

# Optional persistent product-image storage. Uploads are unavailable until all values are set.
# Keep the API secret private and store it in the deployment secret manager in production.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Safaricom Daraja STK Push. Add these only to the API environment, never Vite/client variables.
# MPESA_ENV=sandbox
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_PASSKEY=
# MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
# MPESA_SHORTCODE=
# Generate a random URL-safe secret of 32-128 characters; it protects the callback route.
# MPESA_CALLBACK_TOKEN=
# MPESA_CALLBACK_URL=https://your-public-site.example/api/v1/orders/mpesa/callback/<same-token>
# MPESA_ACCOUNT_REFERENCE=KitCulture
# MPESA_TRANSACTION_DESC=Jersey Purchase
# DARAJA_* aliases are supported. Production requires explicit production mode and all matching live settings.
# Daraja limits AccountReference and TransactionDesc to 12 and 13 characters.

# Transactional email (Resend is the supported provider for this project).
# Set these in Render/Railway secret managers only; never commit them to source control.
# EMAIL_PROVIDER=resend
# EMAIL_FROM=KitCulture <notifications@your-domain.example>
# EMAIL_REPLY_TO=support@your-domain.example
# RESEND_API_KEY=
# ADMIN_NOTIFICATION_EMAIL=admin@your-domain.example
# EMAIL_VERIFICATION_REQUIRED=false
# EMAIL_VERIFICATION_TTL_MINUTES=60
# PASSWORD_RESET_TTL_MINUTES=60

# One-time inputs for `npm run admin:provision`. Remove ADMIN_PASSWORD after use.
# ADMIN_EMAIL=
# ADMIN_NAME=
# ADMIN_PASSWORD=

# Optional IT operator self-signup key. Configure in the API environment only; never use a VITE_ variable.
# Generate at least 32 random characters and unset after the intended signup window closes.
# OPERATIONS_SIGNUP_SECRET=
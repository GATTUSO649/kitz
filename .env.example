NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
DATABASE_URL=mysql://kitculture_app:replace-this-local-password@127.0.0.1:3306/kitculture
ADMIN_DATABASE_URL=mysql://kitculture_admin:replace-this-local-password@127.0.0.1:3306/kitculture_admin

# Local Docker MySQL only. Use a dedicated, least-privilege database user in production.
MYSQL_DATABASE=kitculture
MYSQL_USER=kitculture_app
MYSQL_PASSWORD=replace-this-local-password
MYSQL_ROOT_PASSWORD=replace-this-local-root-password
# Optional MySQL CA certificate for production. Production connections always use verified TLS.
# MYSQL_SSL_CA=

# Optional persistent product-image storage. Uploads are unavailable until all values are set.
# Keep the API secret private and store it in the deployment secret manager in production.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Safaricom Daraja STK Push. Add these only to the server environment, never Vite/client variables.
# DARAJA_ENV=sandbox
# DARAJA_CONSUMER_KEY=
# DARAJA_CONSUMER_SECRET=
# DARAJA_PASSKEY=
# Public HTTPS origin that routes /api/v1/orders/mpesa/callback/* to this API.
# DARAJA_CALLBACK_BASE_URL=https://api.example.com
# Generate a random secret of at least 32 characters; it protects the callback URL.
# DARAJA_CALLBACK_TOKEN=

# Map/routing and email providers are not implemented/configured yet.